# Core API environment — copy to apps/core/.env
#
# NODE_ENV=production requires DATABASE_URL and NEXORA_API_TOKEN.

NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info

# Local Supabase stack. Use DATABASE_SSL=require for Supabase Cloud.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_SSL=disable

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173

# Shared Phase 0 service token. Leave empty only for local development.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXORA_API_TOKEN=
