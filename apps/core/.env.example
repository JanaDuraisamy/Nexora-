# Core API environment — copy to apps/core/.env
#
# NODE_ENV=production requires DATABASE_URL.

NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info

# Local Supabase stack. Use DATABASE_SSL=require for Supabase Cloud.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_SSL=disable

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173

# There is no shared service token any more. Every /v1 request presents a
# per-identity credential issued with:
#
#   npm --prefix apps/core run credential:issue -- --handle ev --label "EV local"
#
# The plaintext token is printed once and only its SHA-256 digest is stored.
# Never commit a token or put one in a client-side bundle.
