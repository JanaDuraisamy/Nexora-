# Console environment — copy to apps/console/.env.local
#
# Vite only exposes variables prefixed with VITE_, and it inlines them into the
# browser bundle. Never put a token, service role key or database URL in this
# file — anything here is public.
#
# The console currently calls only /health and /health/ready, which are public.
# Authenticated console features must go through a server-side proxy.

VITE_NEXORA_API_URL=http://127.0.0.1:4000
