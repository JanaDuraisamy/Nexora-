# Console environment — copy to apps/console/.env.local
#
# Vite only exposes variables prefixed with VITE_. Never put a service role key
# or database URL in this file.

VITE_NEXORA_API_URL=http://127.0.0.1:4000

# Local development only. Remove for any shared or production deployment.
VITE_NEXORA_API_TOKEN=
